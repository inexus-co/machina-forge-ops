# A throwaway VNC server, for developing the RFB client against.
#
# x11vnc in front of a headless X display, rather than a desktop image with VNC bolted on: what
# the client needs to be tested against is the protocol — the DES challenge, the pixel format we
# ask for, whether a keystroke lands — and a window manager with a terminal on it is enough of a
# desktop to see all three.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc fluxbox xterm x11-apps x11-utils \
  && rm -rf /var/lib/apt/lists/*
COPY start-vnc.sh /start-vnc.sh
RUN chmod +x /start-vnc.sh
EXPOSE 5900 5901 5902
CMD ["/start-vnc.sh"]
